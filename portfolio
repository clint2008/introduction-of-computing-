
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clint Rodimo | Student Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #080b16;
            color: #f4f7ff;
            line-height: 1.7;
        }

        :root {
            --blue: #00e5ff;
            --purple: #a855f7;
            --card: #11172a;
            --gray: #a5aec7;
        }

        header {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #080b16;
            border-bottom: 1px solid #27314d;
        }

        nav {
            max-width: 1100px;
            min-height: 70px;
            width: 90%;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
        }

        .logo span,
        h1 span,
        h2 span {
            color: var(--blue);
        }

        .nav-links {
            display: flex;
            flex-wrap: wrap;
            gap: 17px;
            list-style: none;
        }

        a {
            color: var(--gray);
            text-decoration: none;
        }

        .nav-links a:hover {
            color: var(--blue);
        }

        .menu-toggle {
            display: none;
            color: var(--blue);
            background: transparent;
            border: 1px solid var(--blue);
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 20px;
            cursor: pointer;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: auto;
        }

        section {
            padding: 75px 0;
            scroll-margin-top: 70px;
        }

        .alternate {
            background: #0c1020;
        }

        .eyebrow {
            color: var(--blue);
            font-size: 12px;
            letter-spacing: 3px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        h2 {
            font-size: 35px;
            margin-bottom: 20px;
        }

        .description {
            color: var(--gray);
            margin-bottom: 22px;
        }

        /* HOME */

        .hero {
            min-height: 570px;
            display: flex;
            align-items: center;
            background: radial-gradient(
                circle at 80% 40%,
                #241342,
                transparent 45%
            );
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            align-items: center;
            gap: 40px;
        }

        h1 {
            font-size: clamp(35px, 5vw, 60px);
            line-height: 1.2;
            margin-bottom: 15px;
            overflow-wrap: anywhere;
        }

        .subtitle {
            color: var(--purple);
            font-size: 22px;
            margin-bottom: 15px;
        }

        .buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin: 25px 0;
        }

        .btn {
            display: inline-block;
            padding: 10px 18px;
            border: 1px solid var(--blue);
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
        }

        .primary {
            background: var(--blue);
            color: #080b16;
        }

        .secondary {
            color: var(--blue);
        }

        .player-info {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 20px;
            color: var(--gray);
            font-size: 12px;
        }

        /* PROFILE PICTURE */

        .game-card {
            max-width: 340px;
            width: 100%;
            margin: auto;
            padding: 25px;
            text-align: center;
            background: var(--card);
            border: 1px solid var(--purple);
            border-radius: 15px;
            box-shadow: 0 0 30px #a855f722;
        }

        .card-top {
            display: flex;
            justify-content: space-between;
            color: var(--blue);
            font-size: 11px;
            font-weight: bold;
        }

        .avatar {
            width: 140px;
            height: 140px;
            margin: 25px auto;
            border: 3px solid var(--blue);
            border-radius: 50%;
            overflow: hidden;
            box-shadow: 0 0 25px #00e5ff44;
        }

        .avatar img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }

        .card-role {
            color: var(--purple);
            font-size: 12px;
            margin: 8px 0 20px;
        }

        .xp-bar {
            height: 8px;
            margin-top: 8px;
            background: #29304a;
            border-radius: 10px;
            overflow: hidden;
        }

        .xp-progress {
            width: 65%;
            height: 100%;
            background: linear-gradient(
                90deg,
                var(--blue),
                var(--purple)
            );
        }

        .xp-label {
            display: flex;
            justify-content: space-between;
            color: var(--gray);
            font-size: 10px;
        }

        .card-footer {
            color: #4dff9a;
            font-size: 11px;
            margin-top: 20px;
        }

        /* ABOUT */

        .panel {
            padding: 28px;
            background: var(--card);
            border: 1px solid #27314d;
            border-radius: 10px;
        }

        .panel h3 {
            color: var(--purple);
            margin-bottom: 12px;
        }

        .panel p {
            color: var(--gray);
            margin-bottom: 12px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 25px;
        }

        .stat {
            text-align: center;
            padding: 15px 5px;
            background: #18213a;
            border-radius: 8px;
        }

        .stat strong {
            display: block;
            color: var(--blue);
            font-size: 25px;
        }

        .stat span {
            color: var(--gray);
            font-size: 12px;
        }

        /* SKILLS AND PROJECTS */

        .grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .item {
            padding: 22px;
            background: var(--card);
            border: 1px solid #27314d;
            border-radius: 10px;
            transition: 0.3s;
        }

        .item:hover {
            transform: translateY(-5px);
            border-color: var(--blue);
        }

        .item-icon {
            color: var(--blue);
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .item h3 {
            margin-bottom: 8px;
        }

        .item p {
            color: var(--gray);
            font-size: 14px;
        }

        .tag {
            display: inline-block;
            color: var(--purple);
            border: 1px solid var(--purple);
            border-radius: 4px;
            padding: 2px 8px;
            margin-top: 12px;
            font-size: 10px;
        }

        /* EDUCATION */

        .education {
            border-left: 4px solid var(--purple);
        }

        .education .status {
            color: #4dff9a;
            font-size: 12px;
            font-weight: bold;
        }

        .school {
            color: var(--blue) !important;
        }

        /* CONTACT */

        .contact-form {
            max-width: 650px;
        }

        .form-group {
            margin-bottom: 17px;
        }

        label {
            display: block;
            margin-bottom: 6px;
        }

        input,
        textarea {
            width: 100%;
            padding: 12px;
            background: #090e1c;
            border: 1px solid #27314d;
            border-radius: 6px;
            color: white;
            font: inherit;
        }

        input:focus,
        textarea:focus {
            outline: 1px solid var(--blue);
        }

        textarea {
            resize: vertical;
        }

        #form-status {
            color: var(--blue);
            margin-top: 12px;
            font-size: 13px;
        }

        footer {
            padding: 25px 0;
            text-align: center;
            color: var(--gray);
            border-top: 1px solid #27314d;
            font-size: 12px;
        }

        /* RESPONSIVE DESIGN */

        @media (max-width: 800px) {
            .hero-grid {
                grid-template-columns: 1fr;
                gap: 35px;
            }

            .grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .menu-toggle {
                display: block;
            }

            nav {
                position: relative;
            }

            .nav-links {
                display: none;
                position: absolute;
                top: 70px;
                left: 0;
                right: 0;
                padding: 15px;
                background: #11172a;
                flex-direction: column;
                gap: 12px;
                border: 1px solid #27314d;
            }

            .nav-links.open {
                display: flex;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            section {
                padding: 55px 0;
            }

            h2 {
                font-size: 29px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition: none !important;
            }
        }
    </style>
</head>

